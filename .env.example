# Copy to .env and fill in. .env is gitignored — never commit it.
# Only the first two keys are needed for `etsy-engine demo`.

# --- Images: Raywake (required) ---------------------------------------------
# Create a key at https://raywake.com/api-keys?utm_source=github&utm_medium=etsy-engine&utm_campaign=oss&utm_content=env-example with scopes: generate, jobs:read
RAYWAKE_API_KEY=
# Optional overrides (defaults shown)
# RAYWAKE_MODEL=openai/gpt-image-2.5/sunburst/text-to-image
# RAYWAKE_EDIT_MODEL=openai/gpt-image-2.5/sunburst/edit
# RAYWAKE_QUALITY=high

# --- LLM: Anthropic (required) ----------------------------------------------
# Trend scoring, product architecture, page QC (vision), SEO copy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5

# --- Your shop (shown to buyers in delivery PDFs / shop messages) -----------
SHOP_NAME=Your Shop
SHOP_CONTACT_EMAIL=

# --- Etsy (needed to validate demand with real market data and to publish) --
# See docs/SETUP.md. The API key header is "keystring:shared_secret".
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=
ETSY_SCOPES=listings_r listings_w listings_d shops_r shops_w transactions_r

# --- Optional trend sources ---------------------------------------------------
# Reddit (PRAW)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=etsy-engine/0.1 by u_yourname
# X/Twitter trends via Grok x_search on OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4.3
# context.dev competitive-intelligence enrichment (skipped without a key)
CONTEXT_DEV_API_KEY=

# --- Optional distribution: Pinterest API v5 ---------------------------------
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_BOARD_ID=

# --- Funnel sizes (trends inspected -> filtered -> opportunities -> products) -
FUNNEL_INSPECT=100
FUNNEL_FILTER=20
FUNNEL_OPPORTUNITIES=10
FUNNEL_PRODUCTS=3
